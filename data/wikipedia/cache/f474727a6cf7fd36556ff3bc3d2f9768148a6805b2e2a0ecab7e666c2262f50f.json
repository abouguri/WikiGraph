pload.wikimedia.org/wikipedia/commons/a/a4/LuaJIT_Orange_on_Blue_Logo.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled\" decoding=\"async\" loading=\"lazy\" width=\"140\" height=\"65\" style=\"--mw-file-upright: 0.55\" class=\"mw-file-element mw-file-upright\" data-file-width=\"182\" data-file-height=\"84\" /></a></span><div class=\"infobox-caption\">The logo featured on the LuaJIT website.</div></td></tr><tr><td colspan=\"2\" class=\"infobox-image logo\"><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:LuaJIT_REPL_on_Windows.png\" class=\"mw-file-description\"><img alt=\"&quot;LuaJIT REPL running on Windows 10\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/LuaJIT_REPL_on_Windows.png/250px-LuaJIT_REPL_on_Windows.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"133\" style=\"--mw-file-upright: 1\" class=\"mw-file-element mw-file-upright\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/LuaJIT_REPL_on_Windows.png/500px-LuaJIT_REPL_on_Windows.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1235\" data-file-height=\"656\" /></a></span></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;\"><a href=\"/wiki/Programmer\" title=\"Programmer\">Original author</a></th><td class=\"infobox-data\">Mike Pall</td></tr><tr class=\"infobox-hiddenrow\" style=\"display: none;\"><td colspan=\"2\" class=\"infobox-full-data\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;\"><a href=\"/wiki/Software_release_life_cycle\" title=\"Software release life cycle\">Stable release</a></th><td class=\"infobox-data\"><div style=\"margin:0px;\">v2.1.ROLLING<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n   / August&#160;21, 2023<span class=\"noprint\">&#59;&#32;3 years ago</span><span style=\"display:none\">&#160;(<span class=\"bday dtstart published updated\">2023-08-21</span>)</span></div></td></tr><tr style=\"display:none\"><td colspan=\"2\">\n</td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;\">Written in</th><td class=\"infobox-data\"><a href=\"/wiki/C_(programming_language)\" title=\"C (programming language)\">C</a>, <a href=\"/wiki/Lua_(programming_language)\" class=\"mw-redirect\" title=\"Lua (programming language)\">Lua</a></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;\"><a href=\"/wiki/Operating_system\" title=\"Operating system\">Operating system</a></th><td class=\"infobox-data\"><a href=\"/wiki/Unix\" title=\"Unix\">Unix</a>-like, <a href=\"/wiki/MacOS\" title=\"MacOS\">MacOS</a>, <a href=\"/wiki/Microsoft_Windows\" title=\"Microsoft Windows\">Windows</a>, <a href=\"/wiki/IOS\" title=\"IOS\">iOS</a>, <a href=\"/wiki/Android_(operating_system)\" title=\"Android (operating system)\">Android</a>, <a href=\"/wiki/PlayStation\" title=\"PlayStation\">PlayStation</a></td></tr><tr><th scope=\"row\" class=\"infobox-label\" style=\"white-space: nowrap;\"><a href=\"/wiki/Computing_platform\" title=\"Computing platform\">Platform</a></th><td class=\"infobox-data\"><a href=\"/wiki/X86\" title=\"X86\">x86</a>, <a href=\"/wiki/X86-64\" title=\"X86-64\">x86-64</a>, <a href=\"/wiki/PowerPC\" title=\"PowerPC\">PowerPC</a>, <a href=\"/wiki/ARM_architecture_family\" title=\"ARM architecture family\">ARM</a>, <a href=\"/wiki/MIPS_architecture\" title=\"MIPS architecture\">MIPS</a><sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th scope=\"row\" class=\"